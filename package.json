{
  "name": "@memco/eve",
  "version": "0.1.1",
  "description": "Memco Shared Memory as a memory provider for eve agents",
  "license": "MIT",
  "homepage": "https://github.com/memcoai/eve-memco#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memcoai/eve-memco.git"
  },
  "bugs": "https://github.com/memcoai/eve-memco/issues",
  "keywords": [
    "memco",
    "eve",
    "shared-memory",
    "memory",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "workspaces": [
    "examples/single-user",
    "examples/multi-tenant"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check . && node-actionlint '.github/workflows/*.yaml'",
    "format": "prettier --write .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:test": "rm -rf build && tsc -p tsconfig.json",
    "test": "npm run build:test && node --test --enable-source-maps 'build/tests/**/*.test.js'"
  },
  "peerDependencies": {
    "eve": ">=0.84.1 <0.91.0"
  },
  "devDependencies": {
    "@tktco/node-actionlint": "1.6.0",
    "@types/node": "24.19.2",
    "eve": "0.90.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@memco/memcoai": "^0.3.1"
  }
}
