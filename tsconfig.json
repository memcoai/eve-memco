{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The editor project, and what `make typecheck` and `make test` compile.
  // tsconfig.build.json narrows it to src/ for the published package.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": true,

    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    // The examples import the package by name, as an agent would; this maps
    // that name to the source so they are checked without a build.
    "paths": { "@memco/eve": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"]
}
