# Supply-chain guard, as in the SDK repository: freshly published versions are
# held back two days, and no install script ever runs.
ignore-scripts=true
min-release-age=2
# Except the Memco SDK, which we publish ourselves: a fix there is picked up at
# once.
min-release-age-exclude[]=@memco/memcoai
audit=true
fund=false
package-lock=true
strict-ssl=true
save-exact=true
